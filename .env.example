# Local Docker PostgreSQL Configuration
POSTGRES_USER=flightpool
POSTGRES_PASSWORD=change_me
POSTGRES_DB=flightpool
POSTGRES_PORT=5433

# Prisma PostgreSQL Connection String
DATABASE_URL="postgresql://flightpool:change_me@localhost:5433/flightpool?schema=public"
# Application Settings
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Security & Authentication Secrets
SESSION_SECRET="replace_with_min_32_char_secure_random_production_secret"
CRON_SECRET="replace_with_secure_random_cron_secret"
ADMIN_PHONES="+919999999999"
