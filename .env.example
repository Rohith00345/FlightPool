# Local Docker PostgreSQL Configuration
POSTGRES_USER=flightpool
POSTGRES_PASSWORD=flightpool_dev_pass
POSTGRES_DB=flightpool
POSTGRES_PORT=5433

# Prisma PostgreSQL Connection String
DATABASE_URL="postgresql://flightpool:flightpool_dev_pass@localhost:5433/flightpool?schema=public"

# Application Settings
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
