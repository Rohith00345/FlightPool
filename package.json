{
  "name": "flightpool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run tests/ --exclude \"tests/e2e/**\"",
    "test:load": "tsx scripts/load-test.ts",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "tsx scripts/db-guard.ts \"Database reset (db:reset)\" && prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts --prod",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "job:retention": "tsx scripts/retention-job.ts",
    "check": "node scripts/preflight.mjs",
    "verify": "node scripts/verify.mjs",
    "ship": "node scripts/ship.mjs",
    "migrate:live": "node scripts/migrate-live.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "framer-motion": "^14.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
